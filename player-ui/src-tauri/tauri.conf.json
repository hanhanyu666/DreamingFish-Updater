{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DreamingFishUpdater",
  "version": "0.1.32",
  "identifier": "cn.dreamingfish.updater",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "DreamingFish Updater",
        "width": 1180,
        "height": 680,
        "minWidth": 960,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
