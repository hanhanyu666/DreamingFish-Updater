{
  "name": "dreamingfish-admin-desktop",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1421 --strictPort",
    "build": "vue-tsc --noEmit && vite build && node ../packaging/stamp-frontend.mjs admin-desktop dist",
    "build:web": "vue-tsc --noEmit && vite build --config vite.web.config.ts && node ../packaging/stamp-frontend.mjs admin-desktop web-dist",
    "test": "node --test tests/*.test.mjs",
    "tauri": "tauri",
    "check:contract": "node ../packaging/update-task-contract.mjs --check"
  },
  "dependencies": {
    "@lucide/vue": "1.55.0",
    "@tauri-apps/api": "2.11.1",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@vitejs/plugin-vue": "6.0.8",
    "typescript": "~5.9.0",
    "vite": "8.2.0",
    "vue-tsc": "3.3.9"
  }
}
