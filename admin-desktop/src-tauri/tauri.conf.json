{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "梦鱼更新管理",
  "version": "0.2.4",
  "identifier": "cn.dreamingfish.admin.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": ["launcher", "workspace-frame"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; frame-src 'none'; base-uri 'none'; object-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1421 ws://127.0.0.1:1421; frame-src 'none'; base-uri 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "DreamingFish",
    "copyright": "梦鱼更新管理 · DreamingFish",
    "icon": ["icons/icon.ico"],
    "createUpdaterArtifacts": true,
    "resources": {"resources/core/": "core/", "resources/LICENSE": "LICENSE"},
    "windows": {
      "webviewInstallMode": {"type": "downloadBootstrapper"},
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "customLanguageFiles": {"SimpChinese": "installer/SimpChinese.nsh"},
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0MDRGMUYxNDJDNzI0NzQKUldSMEpNZEM4ZkVFWkd0L0RZdGkwTHdPT3drdEVjdHU4SnArN2tQa2w2bE1zemM3dW9MWFRLck4K",
      "endpoints": ["https://github.com/hanhanyu666/DreamingFish-Updater/releases/latest/download/latest.json"],
      "windows": {"installMode": "passive"}
    }
  }
}
